# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cvki
MONGODB_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=10000

# Security
# Development only; replace with a generated secret in production.
ENVIRONMENT=development
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=cvki_access_token
CSRF_COOKIE_NAME=cvki_csrf_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External APIs & Civic Data
REVERSE_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
REVERSE_GEOCODER_USER_AGENT=CVKI/0.2 location foundation
EXTERNAL_DATA_ENABLED=true
EXTERNAL_DATA_REQUEST_TIMEOUT_SECONDS=4.0
WEATHER_PROVIDER_URL=https://api.open-meteo.com/v1/forecast
RAIN_CONTEXT_WINDOW_HOURS=24
TRAFFIC_PROVIDER_URL=
TRAFFIC_API_KEY=

# Computer Vision Model Configuration
YOLO_MODEL_PATH=ai/computer_vision/training/runs/yolov8n_m1_13/weights/best.pt
YOLO_MODEL_VERSION=M1.13-yolov8n
YOLO_DEVICE=cpu
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=40000000
MAX_REQUEST_BODY_BYTES=12582912
REVERSE_GEOCODER_TIMEOUT_SECONDS=5
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTRATION_RATE_LIMIT_REQUESTS=5
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=60
INFERENCE_RATE_LIMIT_REQUESTS=20
INFERENCE_RATE_LIMIT_WINDOW_SECONDS=60
COMPLAINT_RATE_LIMIT_REQUESTS=10
COMPLAINT_RATE_LIMIT_WINDOW_SECONDS=60
DUPLICATE_CHECK_RATE_LIMIT_REQUESTS=20
DUPLICATE_CHECK_RATE_LIMIT_WINDOW_SECONDS=60
EXPENSIVE_SEARCH_RATE_LIMIT_REQUESTS=30
EXPENSIVE_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60

# M7.1 Government Integration Foundation Configuration
GOVERNMENT_INTEGRATION_ENABLED=false
GOVERNMENT_STATUS_SYNC_ENABLED=false
GOVERNMENT_REQUEST_TIMEOUT_SECONDS=5.0
GOVERNMENT_MAX_RETRIES=2
GOVERNMENT_SYNC_INTERVAL_SECONDS=3600

# M7.2 Official Government Portal / API Adapters Configuration
# CPGRAMS (Centralized Public Grievance Redress and Monitoring System - DARPG / NIC)
# Options: unconfigured, staging, production
CPGRAMS_ENV=unconfigured
CPGRAMS_BASE_URL=https://pgportal.gov.in/api/v1
CPGRAMS_API_KEY=
CPGRAMS_CLIENT_ID=
CPGRAMS_AGENCY_CODE=MORTH
CPGRAMS_ENABLED=false

# NHAI (National Highways Authority of India) - No public API; defaults to unconfigured
NHAI_PORTAL_ENABLED=false

# BBMP Sahaaya (Bruhat Bengaluru Mahanagara Palike) - No public API; defaults to unconfigured
BBMP_SAHAAYA_ENABLED=false
